# Supabase (DB + Storage)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="ugc-assets"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin (cuenta con uso ilimitado)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-on-first-login"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI via Vercel AI SDK (scripts con GPT-4o + imagenes con gpt-image-1)
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=""

# Video providers (image-to-video). Al menos uno.
VIDEO_PROVIDER="SEEDANCE"        # default: SEEDANCE | KLING | WAN
SEEDANCE_API_KEY=""
SEEDANCE_API_BASE=""
KLING_API_KEY=""
KLING_API_BASE=""
WAN_API_KEY=""
WAN_API_BASE=""

# Composicion de video
FFMPEG_PATH="ffmpeg"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""
